/**
 * Account screen placeholder — login, whoami and favorites sync arrive with
 * the auth phase; account data is then fetched from the configured server.
 */

import { useEffect, useState } from "react";
import { loadConfig, serverUrl } from "../../services/config";
import { theme } from "../theme";

export function AccountScreen() {
	const [base, setBase] = useState("");
	useEffect(() => {
		void loadConfig().then((config) => setBase(serverUrl(config)));
	}, []);
	return (
		<box
			flexDirection="column"
			flexGrow={1}
			paddingTop={1}
			paddingLeft={2}
			paddingRight={2}
			gap={1}
		>
			<text fg={theme.fg}>
				<strong>Account</strong>
			</text>
			<text fg={theme.textDim}>Sign-in is being wired to {base || "your QBTools server"}.</text>
			<text fg={theme.textSubtle}>
				Once connected: qbtools login --api-key, whoami, and favorites synchronization.
			</text>
		</box>
	);
}
