import { absoluteUrl, SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from "#/lib/site";

export const Route = createFileRoute("/")({
	head: () =>
		seo({
			title: `${SITE_NAME} — ${SITE_TAGLINE}: Free Online Tools, No Signup`,
			rawTitle: true,
			description: SITE_DESCRIPTION,
			path: "/",
			jsonLd: [
				{
					"@context": "https://schema.org",
					"@type": "WebSite",
					name: SITE_NAME,
					url: absoluteUrl("/"),
					potentialAction: {
						"@type": "SearchAction",
						target: `${absoluteUrl("/tools")}?q={search_term_string}`,
						"query-input": "required name=search_term_string",
					},
				},
			],
		}),
	component: HomePage,
});

const QUICK = [
	"compress-image",
	"merge-pdf",
	"remove-background",
	"word-counter",
	"emi-calculator",
	"qr-code-generator",
];

/** Disciplines that actually have tools. */
const activeCategories = categories.filter((c) => toolsInCategory(c.id).length > 0);

const DIRECTORY_PREVIEW = 12;

const VALUE_PROPS = [
	{
		icon: ShieldCheck,
		label: "No server storage",
		tile: "border-cat-emerald-border bg-cat-emerald-bg text-cat-emerald-icon",
	},
	{
		icon: Zap,
		label: "Instant execution",
		tile: "border-cat-amber-border bg-cat-amber-bg text-cat-amber-icon",
	},
	{
		icon: Heart,
		label: "Free forever",
		tile: "border-cat-sky-border bg-cat-sky-bg text-cat-sky-icon",
	},
];

const WHY = [
	{
		title: "Private by design",
		text: "Zero server storage and zero telemetry on your files.",
		icon: ShieldCheck,
		tile: "border-cat-emerald-border bg-cat-emerald-bg text-cat-emerald-icon",
	},
	{
		title: "No signup required",
		text: "Open a tool and use it. An account is optional.",
		icon: KeyRound,
		tile: "border-cat-indigo-border bg-cat-indigo-bg text-cat-indigo-icon",
	},
	{
		title: "Blazing fast",
		text: "Runs on your device, so there is no upload wait.",
		icon: Zap,
		tile: "border-cat-amber-border bg-cat-amber-bg text-cat-amber-icon",
	},
	{
		title: "Works everywhere",
		text: "Any modern browser, on desktop or mobile.",
		icon: Globe,
		tile: "border-cat-sky-border bg-cat-sky-bg text-cat-sky-icon",
	},
];

const BROWSER_STEPS = [
	["Pick a file", "Your file stays on your device the whole time."],
	["Processed locally", "Your browser does the work — instant, with no waiting in a queue."],
	["Download the result", "Nothing is stored on QBTools servers."],
] as const;

const CLOUD_STEPS = [
	["Upload your file", "The document is sent to a remote server."],
	["Wait for processing", "Speed depends on the server and your connection."],
	["Download the result", "Check each provider’s retention policy for your file."],
] as const;

/** Mono kicker, heading and optional description. */
function SectionHead({
	index,
	kicker,
	title,
	id,
	description,
	action,
}: {
	index: number;
	kicker: string;
	title: string;
	id: string;
	description?: string;
	action?: ReactNode;
}) {
	return (
		<div className="flex flex-col gap-2">
			<div className="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
				<p className="label-mono !text-subtle">
					[{String(index).padStart(2, "0")}] {kicker}
				</p>
				{action}
			</div>
			<h2 id={id} className="text-3xl font-semibold tracking-[-0.03em] sm:text-3xl">
				{title}
			</h2>
			{description && <p className="text-base text-muted-foreground sm:text-lg">{description}</p>}
		</div>
	);
}

/** Quiet icon control for the workspace header: lifted surface, muted icon, accent on hover. */
const SHELF_CONTROL = "shrink-0 rounded-[10px] text-muted-foreground hover:text-foreground";

/** Favorites and recent tools, shown only once there is something to show. */
function PersonalShelf() {
	const { user } = useAccount();
	const recent = recentTools.use();
	const rawFavorites = favoriteTools.use();
	const favorites = user ? rawFavorites : [];
	const [tab, setTab] = useState<"all" | "favorites" | "recent">("all");
	const [mounted, setMounted] = useState(false);
	const [stagger, setStagger] = useState(true);
	const [emblaApi, setEmblaApi] = useState<CarouselApi>();
	const [canPrev, setCanPrev] = useState(false);
	const [canNext, setCanNext] = useState(false);
	useEffect(() => {
		setMounted(true);
		const t = setTimeout(() => setStagger(false), 900);
		return () => clearTimeout(t);
	}, []);
	useEffect(() => {
		if (!emblaApi) return;
		const onSelect = () => {
			setCanPrev(emblaApi.canScrollPrev());
			setCanNext(emblaApi.canScrollNext());
		};
		onSelect();
		emblaApi.on("select", onSelect);
		emblaApi.on("reInit", onSelect);
		return () => {
			emblaApi.off("select", onSelect);
			emblaApi.off("reInit", onSelect);
		};
	}, [emblaApi]);

	const allSlugs = [...new Set([...favorites, ...recent])];
	const slugs = tab === "favorites" && user ? favorites : tab === "recent" ? recent : allSlugs;
	const list = slugs.map(getTool).filter((t) => t !== undefined);
	if (!mounted || allSlugs.length === 0) return null;

	return (
		<section
			id="workspace"
			aria-labelledby="your-tools"
			className="container-page relative z-10 pt-16 sm:pt-24"
		>
			<div className="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-6">
				<div className="flex flex-col gap-2">
					<p className="label-mono flex items-center gap-2 !text-subtle">
						Your workspace
						<span aria-hidden="true" className="inline-block h-px w-6 bg-border" />
						<span>
							{allSlugs.length} tool{allSlugs.length === 1 ? "" : "s"}
						</span>
					</p>
					<h2 id="your-tools" className="text-3xl font-semibold tracking-[-0.03em] sm:text-3xl">
						{user ? "Pinned & recent tools" : "Recent tools"}
					</h2>
				</div>
				<div className="flex w-full items-center gap-2 sm:w-auto">
					{recent.length > 0 && (
						<Button
							variant="outline"
							size="icon"
							onClick={() => recentTools.write([])}
							aria-label="Clear recent history"
							title="Clear recent history"
							className={`${SHELF_CONTROL} hover:border-cat-rose-border hover:bg-cat-rose-bg hover:text-cat-rose-icon`}
						>
							<RotateCcw />
						</Button>
					)}
					{list.length > 0 && (
						<>
							<Button
								variant="outline"
								size="icon"
								className={`hidden sm:inline-flex ${SHELF_CONTROL}`}
								disabled={!canPrev}
								onClick={() => emblaApi?.scrollPrev()}
								aria-label="Previous tools"
							>
								<ArrowLeft />
							</Button>
							<Button
								variant="outline"
								size="icon"
								className={`hidden sm:inline-flex ${SHELF_CONTROL}`}
								disabled={!canNext}
								onClick={() => emblaApi?.scrollNext()}
								aria-label="Next tools"
							>
								<ArrowRight />
							</Button>
						</>
					)}
					{user && (
						<Segmented
							label="Show"
							size="toolbar"
							value={tab}
							onChange={setTab}
							options={[
								{ value: "all", label: `All ${allSlugs.length}` },
								{ value: "favorites", label: `Saved ${favorites.length}` },
								{ value: "recent", label: `Recent ${recent.length}` },
							]}
							className="min-w-0 flex-1 rounded-[10px] sm:flex-none"
						/>
					)}
				</div>
			</div>

			<div className="mt-4">
				{list.length === 0 ? (
					<div className="flex flex-col items-center rounded-xl border border-dashed border-border bg-card/40 px-4 py-8 text-center">
						<span
							aria-hidden="true"
							className="grid size-9 place-items-center rounded-full border border-border bg-card text-muted-foreground"
						>
							<Pin className="size-4" />
						</span>
						<p className="mt-3 text-sm font-medium text-foreground">
							{tab === "favorites" && user ? "No saved tools yet" : "No recent tools yet"}
						</p>
						<p className="mt-1 text-sm text-muted-foreground">
							{tab === "favorites" && user
								? "Star a tool to pin it here."
								: "Open a tool and it will appear here."}
						</p>
					</div>
				) : (
					<Carousel
						key={`${tab}-${list.length}`}
						opts={{ align: "start", containScroll: "trimSnaps" }}
						setApi={setEmblaApi}
						className="focus-visible:outline-none"
					>
						<CarouselContent className="-ml-3">
							{list.slice(0, 6).map((tool, i) => (
								<CarouselItem
									key={tool.slug}
									className={cn(
										"pl-3 sm:basis-1/2 lg:basis-1/3",
										list.length > 1 ? "basis-[88%]" : "basis-full",
									)}
								>
									<ShelfToolCard tool={tool} index={i} stagger={stagger} className="h-full" />
								</CarouselItem>
							))}
						</CarouselContent>
					</Carousel>
				)}
			</div>
		</section>
	);
}

type TagFilter = DirectoryTag;
type SortBy = DirectorySort;

const TAG_OPTIONS = DIRECTORY_TAG_OPTIONS;

/** Removable token for one active directory filter. */
function ActiveFilter({ label, onRemove }: { label: string; onRemove: () => void }) {
	return (
		<span className="inline-flex h-7 items-center gap-1 rounded-full border border-border bg-card pr-0.5 pl-2.5 text-xs text-muted-foreground">
			{label}
			<button
				type="button"
				onClick={onRemove}
				aria-label={`Remove ${label} filter`}
				className="grid size-5 cursor-pointer place-items-center rounded-full transition-colors duration-150 hover:bg-accent hover:text-foreground"
			>
				<X className="size-3" aria-hidden="true" />
			</button>
		</span>
	);
}

/** Directory: category and tag filters, live search, sort, and a card grid. */
function ToolsDirectory() {
	const [activeCategory, setActiveCategory] = useState<CategoryId | "all">("all");
	const [searchQuery, setSearchQuery] = useState("");
	const [tagFilter, setTagFilter] = useState<TagFilter>("all");
	const [sortBy, setSortBy] = useState<SortBy>("popular");
	const [expanded, setExpanded] = useState(false);
	const [filtersOpen, setFiltersOpen] = useState(false);
	const searchRef = useRef<HTMLInputElement>(null);
	const mobileSearchRef = useRef<HTMLInputElement>(null);

	const filteredTools = useMemo(() => {
		let list = [...tools];
		if (activeCategory !== "all") list = list.filter((t) => t.category === activeCategory);
		if (tagFilter === "popular") list = list.filter((t) => t.popular !== undefined);
		else if (tagFilter === "browser") list = list.filter((t) => t.runtime === "browser");
		else if (tagFilter === "ai") list = list.filter((t) => t.runtime === "server-ai");
		const q = searchQuery.toLowerCase().trim();
		if (q) {
			list = list.filter(
				(t) =>
					t.name.toLowerCase().includes(q) ||
					t.tagline.toLowerCase().includes(q) ||
					t.category.toLowerCase().includes(q) ||
					t.keywords.some((k) => k.toLowerCase().includes(q)),
			);
		}
		if (sortBy === "popular") list.sort((a, b) => (a.popular ?? 99) - (b.popular ?? 99));
		else if (sortBy === "name") list.sort((a, b) => a.name.localeCompare(b.name));
		else list.sort((a, b) => a.category.localeCompare(b.category));
		return list;
	}, [activeCategory, tagFilter, searchQuery, sortBy]);

	const filtering = activeCategory !== "all" || tagFilter !== "all" || searchQuery.trim() !== "";
	const collapsed = !filtering && !expanded && filteredTools.length > DIRECTORY_PREVIEW;
	const visible = collapsed ? filteredTools.slice(0, DIRECTORY_PREVIEW) : filteredTools;
	const reset = () => {
		setActiveCategory("all");
		setSearchQuery("");
		setTagFilter("all");
	};

	const activeFacetCount =
		(activeCategory !== "all" ? 1 : 0) +
		(tagFilter !== "all" ? 1 : 0) +
		(searchQuery.trim() !== "" ? 1 : 0);

	return (
		<section
			id="tools-directory"
			aria-labelledby="tools-explorer"
			className="container-page relative z-10 pt-20 sm:pt-28"
		>
			<SectionHead
				index={1}
				kicker="Interactive tools directory"
				title="Find the right tool in seconds"
				id="tools-explorer"
				description={`${tools.length} tools across ${activeCategories.length} disciplines. Everything runs in your browser.`}
			/>

			{/* Mobile filter dock: sticky search + sheet trigger, facet tokens below. */}
			<div className="sticky top-16 z-30 mt-6 rounded-xl border border-border/70 bg-background/85 p-2 shadow-2xs backdrop-blur-xl sm:hidden">
				<div className="flex items-center gap-2">
					<div className="relative min-w-0 flex-1">
						<Search className="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted-foreground" />
						<Input
							ref={mobileSearchRef}
							type="search"
							aria-label="Search tools"
							value={searchQuery}
							onChange={(e) => setSearchQuery(e.target.value)}
							placeholder="Search tools…"
							className="h-11 pr-10 pl-9 [&::-webkit-search-cancel-button]:hidden"
						/>
						{searchQuery ? (
							<button
								type="button"
								onClick={() => setSearchQuery("")}
								aria-label="Clear search"
								className="absolute top-1/2 right-1.5 grid size-8 -translate-y-1/2 cursor-pointer place-items-center rounded-md text-muted-foreground transition-colors duration-150 hover:bg-accent hover:text-foreground"
							>
								<X className="size-4" />
							</button>
						) : null}
					</div>
					<Button
						type="button"
						variant="outline"
						size="icon"
						onClick={() => setFiltersOpen(true)}
						aria-label={activeFacetCount > 0 ? `Filters, ${activeFacetCount} active` : "Filters"}
						aria-haspopup="dialog"
						className="relative h-11 w-11 shrink-0"
					>
						<SlidersHorizontal className="size-4" />
						{activeFacetCount > 0 ? (
							<span
								aria-hidden="true"
								className="absolute -top-1 -right-1 grid size-5 place-items-center rounded-full bg-primary font-mono text-[0.625rem] font-medium text-primary-foreground"
							>
								{activeFacetCount}
							</span>
						) : null}
					</Button>
				</div>

				{filtering ? (
					<div className="mt-2 flex items-center gap-1.5 overflow-x-auto px-0.5 pb-0.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
						{searchQuery.trim() !== "" && (
							<ActiveFilter label={`“${searchQuery.trim()}”`} onRemove={() => setSearchQuery("")} />
						)}
						{activeCategory !== "all" && (
							<ActiveFilter
								label={categoryShortName(categoryById[activeCategory].name)}
								onRemove={() => setActiveCategory("all")}
							/>
						)}
						{tagFilter !== "all" && (
							<ActiveFilter
								label={TAG_OPTIONS.find((o) => o.value === tagFilter)?.label ?? tagFilter}
								onRemove={() => setTagFilter("all")}
							/>
						)}
					</div>
				) : null}
			</div>

			<div className="mt-8 hidden sm:block">
				<div className="flex flex-col gap-3 lg:flex-row lg:items-center">
					<div className="relative w-full lg:max-w-md lg:flex-1">
						<Search className="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted-foreground" />
						<Input
							ref={searchRef}
							type="search"
							aria-label="Search tools"
							value={searchQuery}
							onChange={(e) => setSearchQuery(e.target.value)}
							placeholder="Search tools…"
							className="h-10 pr-10 pl-9 [&::-webkit-search-cancel-button]:hidden"
						/>
						{searchQuery ? (
							<button
								type="button"
								onClick={() => {
									setSearchQuery("");
									searchRef.current?.focus();
								}}
								aria-label="Clear search"
								className="absolute top-1/2 right-2 grid size-7 -translate-y-1/2 cursor-pointer place-items-center rounded-md text-muted-foreground transition-colors duration-150 hover:bg-accent hover:text-foreground"
							>
								<X className="size-3.5" />
							</button>
						) : null}
					</div>
					<div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:flex-wrap lg:ml-auto lg:flex-nowrap">
						<Select
							value={activeCategory}
							onValueChange={(val) => setActiveCategory(isCategoryId(val) ? val : "all")}
						>
							<SelectTrigger aria-label="Discipline" className="h-10 w-full sm:w-[208px]">
								<div className="flex min-w-0 flex-1 items-center gap-2">
									<span
										aria-hidden="true"
										className={cn(
											"size-2 shrink-0 rounded-full",
											activeCategory === "all" ? "bg-primary" : categoryStyles[activeCategory].dot,
										)}
									/>
									<span className="truncate">
										{activeCategory === "all"
											? "All disciplines"
											: categoryShortName(categoryById[activeCategory].name)}
									</span>
									<span className="ml-auto font-mono text-xs text-muted-foreground">
										{activeCategory === "all"
											? tools.length
											: toolsInCategory(activeCategory).length}
									</span>
								</div>
							</SelectTrigger>
							<SelectContent>
								<SelectItem value="all">
									<span className="flex w-full items-center gap-2">
										<span aria-hidden="true" className="size-2 rounded-full bg-primary" />
										<span>All disciplines</span>
										<span className="ml-auto font-mono text-xs text-muted-foreground">
											{tools.length}
										</span>
									</span>
								</SelectItem>
								{activeCategories.map((c) => (
									<SelectItem key={c.id} value={c.id}>
										<span className="flex w-full items-center gap-2">
											<span
												aria-hidden="true"
												className={cn("size-2 rounded-full", categoryStyles[c.id].dot)}
											/>
											<span>{categoryShortName(c.name)}</span>
											<span className="ml-auto font-mono text-xs text-muted-foreground">
												{toolsInCategory(c.id).length}
											</span>
										</span>
									</SelectItem>
								))}
							</SelectContent>
						</Select>
						<Select value={sortBy} onValueChange={(val) => setSortBy(val as SortBy)}>
							<SelectTrigger aria-label="Sort tools" className="h-10 w-full sm:w-[170px]">
								<SelectValue placeholder="Sort: Popular" />
							</SelectTrigger>
							<SelectContent>
								<SelectItem value="popular">Sort: Popular</SelectItem>
								<SelectItem value="name">Sort: Name (A–Z)</SelectItem>
								<SelectItem value="category">Sort: Category</SelectItem>
							</SelectContent>
						</Select>
						<Segmented
							size="toolbar"
							label="Filter tools by type"
							value={tagFilter}
							onChange={setTagFilter}
							options={TAG_OPTIONS}
							className="w-full sm:w-auto"
						/>
					</div>
				</div>
			</div>

			<div className="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 sm:mt-6">
				<p className="text-sm text-muted-foreground" aria-live="polite">
					Showing <span className="font-medium text-foreground">{visible.length}</span> of{" "}
					{tools.length} tools
				</p>
				{filtering && (
					<div className="hidden flex-wrap items-center gap-1.5 sm:flex">
						{searchQuery.trim() !== "" && (
							<ActiveFilter label={`“${searchQuery.trim()}”`} onRemove={() => setSearchQuery("")} />
						)}
						{activeCategory !== "all" && (
							<ActiveFilter
								label={categoryShortName(categoryById[activeCategory].name)}
								onRemove={() => setActiveCategory("all")}
							/>
						)}
						{tagFilter !== "all" && (
							<ActiveFilter
								label={TAG_OPTIONS.find((o) => o.value === tagFilter)?.label ?? tagFilter}
								onRemove={() => setTagFilter("all")}
							/>
						)}
						<Button
							variant="ghost"
							size="sm"
							onClick={reset}
							className="h-7 px-2 text-muted-foreground hover:text-foreground"
						>
							<RotateCcw className="size-3.5" /> Reset all
						</Button>
					</div>
				)}
			</div>

			{filteredTools.length === 0 ? (
				<div className="mt-4 flex flex-col items-center rounded-xl border border-dashed border-border bg-card/40 p-10 text-center sm:p-12">
					<span className="grid size-11 place-items-center rounded-full border border-border bg-background text-muted-foreground">
						<SearchX className="size-5" aria-hidden="true" />
					</span>
					<p className="mt-4 text-lg font-semibold">No matching tools</p>
					<p className="mt-1 max-w-sm text-sm text-muted-foreground">
						Try a different search, discipline, or filter.
					</p>
					<Button variant="outline" size="sm" className="mt-4" onClick={reset}>
						Clear filters
					</Button>
					<div className="mt-6 flex flex-wrap items-center justify-center gap-2">
						<span className="pr-1 font-mono text-[0.625rem] font-medium tracking-[0.1em] text-subtle uppercase">
							Try
						</span>
						{tools
							.filter((t) => t.popular !== undefined)
							.slice(0, 3)
							.map((tool) => (
								<Link
									key={tool.slug}
									to="/tools/$slug"
									params={{ slug: tool.slug }}
									className="inline-flex h-8 items-center rounded-full border border-input bg-background px-3 text-sm font-medium transition-colors duration-150 hover:bg-accent"
								>
									{tool.name}
								</Link>
							))}
					</div>
				</div>
			) : (
				<>
					<ul className="mt-3 flex flex-col gap-2 sm:hidden">
						{visible.map((tool) => (
							<li key={tool.slug}>
								<ToolCard tool={tool} variant="compact" />
							</li>
						))}
					</ul>
					<div className="mt-4 hidden grid-cols-1 gap-4 sm:grid sm:grid-cols-2 lg:grid-cols-3">
						{visible.map((tool) => (
							<ShowcaseToolCard key={tool.slug} tool={tool} />
						))}
					</div>
				</>
			)}

			<MobileFilterSheet
				open={filtersOpen}
				onOpenChange={setFiltersOpen}
				activeCategory={activeCategory}
				onCategoryChange={setActiveCategory}
				tagFilter={tagFilter}
				onTagFilterChange={setTagFilter}
				sortBy={sortBy}
				onSortChange={setSortBy}
				resultCount={filteredTools.length}
				onReset={reset}
				hasActiveFilters={filtering}
			/>

			{collapsed && (
				<div className="mt-8 flex justify-center">
					<Button
						variant="outline"
						size="lg"
						arrow
						onClick={() => setExpanded(true)}
						className="w-full sm:w-auto"
					>
						Show all {tools.length} tools
					</Button>
				</div>
			)}
		</section>
	);
}

function CompareCard({
	tone,
	title,
	badge,
	steps,
}: {
	tone: "emerald" | "rose";
	title: string;
	badge: ReactNode;
	steps: ReadonlyArray<readonly [string, string]>;
}) {
	const number =
		tone === "emerald"
			? "border-cat-emerald-border bg-cat-emerald-bg text-cat-emerald-fg"
			: "border-cat-rose-border bg-cat-rose-bg text-cat-rose-fg";
	return (
		<div
			className={cn(
				"flex flex-col gap-5 rounded-lg border bg-card p-6",
				tone === "emerald" ? "border-cat-emerald-border" : "border-cat-rose-border",
			)}
		>
			<div className="flex flex-wrap items-center gap-3">
				<h3 className="text-2xl font-semibold tracking-[-0.025em]">{title}</h3>
				{badge}
			</div>
			<ol className="flex flex-col gap-4">
				{steps.map(([step, text], i) => (
					<li key={step} className="flex gap-3">
						<span
							className={cn(
								"grid size-7 shrink-0 place-items-center rounded-full border font-mono text-xs",
								number,
							)}
						>
							{i + 1}
						</span>
						<span className="flex flex-col">
							<span className="text-sm font-medium">{step}</span>
							<span className="text-sm text-muted-foreground">{text}</span>
						</span>
					</li>
				))}
			</ol>
		</div>
	);
}

