									{tool.name}
								</Link>
							))}
					</div>
				</div>
			</section>

			<PersonalShelf />

			<ToolsDirectory />

			{/* Categories */}
			<section
				id="categories"
				aria-labelledby="categories-title"
				className="ambient-band mt-32 scroll-mt-16 py-26 sm:mt-48 sm:py-48"
			>
				<div className="container-page">
					<SectionHead
						index={2}
