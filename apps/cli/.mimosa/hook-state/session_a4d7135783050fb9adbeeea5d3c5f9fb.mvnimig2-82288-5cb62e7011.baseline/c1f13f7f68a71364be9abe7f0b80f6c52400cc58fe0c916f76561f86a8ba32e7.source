/**
 * Account screen — local-first framing. The CLI is fully usable signed out;
 * connecting an account is optional and unlocks sync, AI helpers and media
 * storage. Login itself is headless (`qbtools login --api-key …`) because
 * keys are created in the web dashboard.
 */

import { useEffect, useState } from "react";
import { loadAuth, type StoredAuth } from "../../services/auth-store";
import { loadConfig, serverUrl } from "../../services/config";
import { accents, theme } from "../theme";

const UNLOCKS: Array<[string, string]> = [
	["Favorites & recents sync", "your tool list follows you between machines"],
	["AI helpers", "grammar checker and paraphraser run on your server"],
	["Media storage", "upload files and copy them back down (qbtools media)"],
];

export function AccountScreen() {
	const [auth, setAuth] = useState<StoredAuth | null>(null);
	const [base, setBase] = useState("");
	useEffect(() => {
		void loadAuth().then(setAuth);
		void loadConfig().then((config) => setBase(serverUrl(config)));
	}, []);

	const signedIn = auth !== null;

	return (
		<box flexDirection="column" flexGrow={1} paddingTop={1} paddingLeft={2} paddingRight={2} gap={1}>
			<text fg={theme.fg}><strong>Account</strong></text>
			{signedIn ? (
				<text fg={accents.emerald}>
					● Signed in as {auth.user?.email ?? auth.user?.name ?? "user"} (
					{auth.kind === "token" ? "API key" : "session"})
				</text>
			) : (
				<text>
					<span fg={accents.emerald}>●</span>
					<span fg={theme.textDim}> Working in local mode — all 42 tools run offline, no account needed.</span>
				</text>
			)}
			<text fg={theme.textDim}>Server: {base || "(not set — optional, see Settings)"}</text>

			<box flexDirection="column" gap={0}>
				<text fg={theme.fg}><strong>What an account unlocks</strong></text>
				{UNLOCKS.map(([title, detail]) => (
					<text key={title}>
						<span fg={theme.textSubtle}>  · </span>
						<span fg={theme.textDim}>{title}</span>
						<span fg={theme.textSubtle}> — {detail}</span>
					</text>
				))}
			</box>

			<box flexDirection="column" gap={0}>
				<text fg={theme.fg}><strong>Connect (optional)</strong></text>
				<text fg={theme.textDim}>1. Open {base || "the app"}/dashboard/settings</text>
				<text fg={theme.textDim}>2. Create a key in the CLI API keys card (shown once)</text>
				<text fg={theme.textDim}>3. Run  qbtools login --api-key qbk_…</text>
			</box>
			<text fg={theme.textSubtle}>
				Favorites and run history sync on login; offline they stay on this machine.
			</text>
		</box>
	);
}