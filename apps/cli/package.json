{
	"name": "@qbtools/cli",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"module": "src/bin.tsx",
	"description": "QBTools in your terminal — 42 developer & productivity tools, system cleanup, and scripting-friendly output. Built with OpenTUI.",
	"bin": {
		"qbtools": "./dist/bin.js"
	},
	"publishConfig": {
		"name": "qbtools",
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"docs"
	],
	"scripts": {
		"dev": "bun run --watch src/bin.tsx",
		"start": "bun run src/bin.tsx",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"build": "bun build src/bin.tsx --compile --outfile=dist/qbtools --target=bun",
		"build:package": "bun run scripts/build-package.ts",
		"prepack": "bun run build:package"
	},
	"dependencies": {
		"@opentui/core": "^0.6.8",
		"@opentui/keymap": "^0.6.8",
		"@opentui/react": "^0.6.8",
		"@qbtools/engines": "workspace:*",
		"@qbtools/registry": "workspace:*",
		"qrcode": "^1.5.4",
		"react": "^19.2.8"
	},
	"optionalDependencies": {
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"@types/qrcode": "^1.5.5",
		"@types/react": "^19.2.8",
		"@fontsource/anton": "^5.2.5",
		"@fontsource/bebas-neue": "^5.2.5",
		"@fontsource/caveat": "^5.2.5",
		"@fontsource/dm-mono": "^5.2.5",
		"@fontsource/inter": "^5.2.5",
		"@fontsource/playfair-display": "^5.2.5",
		"@fontsource/space-grotesk": "^5.2.5",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.4.0"
	}
}
