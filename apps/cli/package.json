{
	"name": "@quadbits.io/qbtools",
	"version": "0.2.0",
	"type": "module",
	"module": "src/bin.tsx",
	"description": "QBTools in your terminal — 42 developer & productivity tools, system cleanup, and scripting-friendly output. Built with Ink.",
	"bin": {
		"qbtools": "./dist/bin.js"
	},
	"homepage": "https://github.com/Quadbits-Lab/QBTools/tree/beta/apps/cli#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Quadbits-Lab/QBTools.git",
		"directory": "apps/cli"
	},
	"bugs": "https://github.com/Quadbits-Lab/QBTools/issues",
	"keywords": [
		"cli",
		"tui",
		"ink",
		"bun",
		"pdf",
		"image",
		"developer-tools",
		"privacy"
	],
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/bin.js",
		"dist/bin.js.map",
		"README.md",
		"docs"
	],
	"scripts": {
		"dev": "bun run --watch src/bin.tsx",
		"start": "bun run src/bin.tsx",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"build": "bun build src/bin.tsx --compile --outfile=dist/qbtools --target=bun",
		"build:package": "bun run scripts/build-package.ts",
		"prepack": "bun run build:package"
	},
	"dependencies": {
		"@bokuweb/zstd-wasm": "^0.0.27",
		"@fontsource/anton": "^5.2.5",
		"@fontsource/bebas-neue": "^5.2.5",
		"@fontsource/caveat": "^5.2.5",
		"@fontsource/dm-mono": "^5.2.5",
		"@fontsource/inter": "^5.2.5",
		"@fontsource/playfair-display": "^5.2.5",
		"@fontsource/space-grotesk": "^5.2.5",
		"@jsquash/avif": "^2.1.1",
		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/oxipng": "^2.3.0",
		"@jsquash/webp": "^1.5.0",
		"@neslinesli93/qpdf-wasm": "^0.3.0",
		"@resvg/resvg-wasm": "^2.6.2",
		"@visioncortex/vtracer": "^1.0.0-alpha.4",
		"brotli-wasm": "^3.0.1",
		"client-zip": "^2.5.0",
		"dompurify": "^3.4.17",
		"hash-wasm": "^4.12.0",
		"ink": "^6.8.0",
		"mediabunny": "^1.62.1",
		"opentype.js": "^2.0.0",
		"pdf-lib": "^1.17.1",
		"prettier": "^3.5.3",
		"qrcode": "^1.5.4",
		"react": "^19.2.8",
		"sql-formatter": "^15.6.9",
		"zxing-wasm": "^3.1.6"
	},
	"optionalDependencies": {
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@qbtools/engines": "workspace:*",
		"@qbtools/registry": "workspace:*",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.2.8",
		"@types/react-dom": "^19.2.8",
		"ink-testing-library": "^4.0.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"bun": ">=1.4.0"
	}
}
