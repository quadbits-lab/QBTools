# ─────────────────────────────────────────────────────────────
# QBTools configuration. Copy to `.env` (Docker) or `apps/web/.env` (local dev).
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────
APP_ENV=development

# Public origin used for canonical URLs, sitemap.xml and robots.txt.
# Baked into the browser bundle at build time (as VITE_SITE_URL) — rebuild after changing.
SITE_URL=https://qbtools.example.com
VITE_SITE_URL=https://qbtools.example.com

# Host port Docker Compose publishes (container always listens on 8310).
PORT=8310

# SQLite file. Docker uses the named volume at /data.
DATABASE_PATH=./data/qbtools.db

# Admin dashboard at /admin. 16+ random characters; leave empty to disable.
# Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=

# Set to true when a reverse proxy / tunnel sits in front (reads X-Forwarded-For
# for rate limiting). Set HSTS=true only when the site is served over HTTPS.
TRUST_PROXY=false
HSTS=false

# ── AI text helpers (grammar + paraphrase). Empty = tools show "unavailable". ──
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_MAX_INPUT_CHARS=5000

# ── Abuse protection (per IP, per hour) ──
RATE_LIMIT_FORMS_PER_HOUR=10
RATE_LIMIT_AI_PER_HOUR=30

# ── Contact email shown on the site (public) ──
VITE_CONTACT_EMAIL=hello@qbtools.example.com

# ── Google AdSense (public; leave empty until approved) ──
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_BOTTOM=
# Served at /ads.txt, e.g. "google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0"
ADS_TXT=

# ── Privacy-friendly analytics (public; optional) ──
# Plausible: VITE_ANALYTICS_SRC=https://plausible.io/js/script.js + VITE_ANALYTICS_DOMAIN
# Umami:     VITE_ANALYTICS_SRC=https://your-umami/script.js + VITE_ANALYTICS_WEBSITE_ID
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_WEBSITE_ID=

# Optional GitHub accounts: set all four together, or leave all empty.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PGLITE_DATA_DIR=./data/users

# Private RustFS bucket, unversioned, with no anonymous access or Object Lock.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for the optional local Compose storage profile. Use unique credentials.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Host port for the opt-in Ollama proxy (`--profile ollama`).
OLLAMA_PORT=8172
# Bearer token required by that proxy. Generate one with: openssl rand -hex 32
OLLAMA_API_KEY=