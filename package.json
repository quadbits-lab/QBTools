{
	"name": "qbtools",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.3",
	"engines": {
		"bun": ">=1.4.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev --filter=@qbtools/web",
		"build": "turbo run build --filter=@qbtools/web",
		"start": "bun run --cwd apps/web start",
		"cli": "bun run --cwd apps/cli start",
		"typecheck": "turbo run typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun test",
		"db:backup": "bun run --cwd packages/db backup",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"test:browser": "playwright test",
		"assets:prepare": "bun scripts/prepare-wasm.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@playwright/test": "^1.64.1",
		"@types/bun": "^1.4.4",
		"turbo": "^2.11.10",
		"typescript": "~6.0.3"
	}
}
