{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"env": ["VITE_*", "SITE_URL"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		}
	},
	"globalPassThroughEnv": [
		"QBTOOLS_TEST_URL",
		"QBTOOLS_AUTH_FIXTURE",
		"QBTOOLS_RUSTFS_TEST",
		"PGLITE_DATA_DIR",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"GITHUB_CLIENT_ID",
		"GITHUB_CLIENT_SECRET",
		"S3_ENDPOINT",
		"S3_BUCKET",
		"S3_REGION",
		"S3_ACCESS_KEY_ID",
		"S3_SECRET_ACCESS_KEY"
	]
}
